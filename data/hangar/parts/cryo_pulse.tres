"text": "Freeze lasts 0.5s longer per level"
}, {
"effects": [{
"op": &"add",
"stat": &"freeze_charges",
"value": 1
}],
"id": &"charges",
"max": 2,
"name": "CHARGES",
"text": "+1 freeze per stage per level"
}])
part = &"dish_system"
