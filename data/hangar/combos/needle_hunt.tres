[gd_resource type="Resource" script_class="LinkComboDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/link_combo_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"needle_hunt"
display_name = "Needle Hunt"
text = "Seeking shots pierce 1 more and turn harder"
chips = Array[StringName]([&"seeker_chip", &"pierce_chip"])
effects = Array[Dictionary]([{
"op": &"add",
"stat": &"homing",
"value": 1.5
}, {
"op": &"add",
"stat": &"pierce",
"value": 1
}])
