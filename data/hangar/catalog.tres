chips = Array[ExtResource("cdef")]([ExtResource("c_power_chip"), ExtResource("c_rapid_chip"), ExtResource("c_split_chip"), ExtResource("c_seeker_chip"), ExtResource("c_pierce_chip"), ExtResource("c_ember_chip"), ExtResource("c_frost_chip"), ExtResource("c_volt_chip")])
combos = Array[ExtResource("kdef")]([ExtResource("k_inferno"), ExtResource("k_firestorm"), ExtResource("k_blizzard"), ExtResource("k_glacier_lance"), ExtResource("k_storm_net"), ExtResource("k_thunder_seeker"), ExtResource("k_hammer_burst"), ExtResource("k_needle_hunt"), ExtResource("k_plasma_arc"), ExtResource("k_shatter")])
pilots = Array[ExtResource("pdef")]([ExtResource("p_vega"), ExtResource("p_rook"), ExtResource("p_nyx"), ExtResource("p_juno")])
starter_mounts = {
"left": &"bubble",
"nose": &"pulse_laser",
"rear": &"ion_thruster",
"right": &"cryo_pulse"
}
placement = {
"engine": {
"left": [{
"op": &"mul",
"stat": &"strafe_right",
"value": 1.25
}],
"rear": [{
"op": &"mul",
"stat": &"move_speed",
"value": 1.15
}],
"right": [{
"op": &"mul",
"stat": &"strafe_left",
"value": 1.25
}]
},
"shield": {
