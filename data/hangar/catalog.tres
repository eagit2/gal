[resource]
script = ExtResource("1")
ships = Array[ExtResource("sdef")]([ExtResource("s_kestrel")])
parts = Array[ExtResource("ptdef")]([ExtResource("pt_pulse_laser"), ExtResource("pt_twin_cannon"), ExtResource("pt_needle_gun"), ExtResource("pt_missile_pod"), ExtResource("pt_arc_lance"), ExtResource("pt_bubble"), ExtResource("pt_regen_field"), ExtResource("pt_ablative_armor"), ExtResource("pt_prism_shield"), ExtResource("pt_cryo_pulse"), ExtResource("pt_ion_thruster"), ExtResource("pt_vector_jet"), ExtResource("pt_phase_engine"), ExtResource("pt_scrap_magnet"), ExtResource("pt_scrap_compactor"), ExtResource("pt_drone_bay"), ExtResource("pt_combo_amp"), ExtResource("pt_spare_hull")])
pilots = Array[ExtResource("pdef")]([ExtResource("p_vega"), ExtResource("p_rook"), ExtResource("p_nyx"), ExtResource("p_juno")])
starter_mounts = {
"left": &"bubble",
"nose": &"pulse_laser",
"rear": &"ion_thruster",
"right": &"cryo_pulse"
}
placement = {
"engine": {
"left": [{
"op": &"mul",
"stat": &"strafe_right",
"value": 1.25
}],
"rear": [{
"op": &"mul",
"stat": &"move_speed",
"value": 1.15
}],
"right": [{
"op": &"mul",
"stat": &"strafe_left",
"value": 1.25
}]
},
"shield": {
"left": [{
"op": &"mul",
"stat": &"shield_recharge",
"value": 0.8
}],
"right": [{
"op": &"mul",
"stat": &"shield_recharge",
"value": 0.8
}]
}
}
