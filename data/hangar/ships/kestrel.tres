[resource]
script = ExtResource("1")
id = &"kestrel"
display_name = "Kestrel"
description = "Base ship. One weapon on the nose; a power, a shield and a bonus part on the left, rear and right mounts."
slots = {
&"bonus": 1,
&"power": 1,
&"shield": 1,
&"weapon": 1
}
mounts = Array[StringName]([&"nose", &"left", &"rear", &"right"])
sprite = ExtResource("2")
tree = Array[ExtResource("tdef")]([ExtResource("t_focus_lens"), ExtResource("t_rail_coil"), ExtResource("t_hunter_core"), ExtResource("t_twin_rail"), ExtResource("t_plating"), ExtResource("t_capacitor"), ExtResource("t_shock_plate"), ExtResource("t_afterburn"), ExtResource("t_slip_jets"), ExtResource("t_overdrive_core"), ExtResource("t_salvage_rig"), ExtResource("t_tractor"), ExtResource("t_chrono_cell"), ExtResource("t_combo_wiring")])
